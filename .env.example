# Contact form (Resend) — copy to .env.local and fill in.
# Create a key at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered (your inbox)
CONTACT_TO_EMAIL=you@example.com

# From address. Use onboarding@resend.dev for testing, or a verified
# domain sender once you've verified a domain in Resend.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
